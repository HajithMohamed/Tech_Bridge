NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/techbridge_local
# Supply a new random secret locally; never reuse a tracked or demonstration value.
JWT_SECRET=
JWT_EXPIRES_IN=7d
# Development mail is saved privately under backend/.cache/mail; never sent.
# Production delivery stays disabled until a real delivery adapter is configured.
PUBLIC_APP_URL=http://localhost:5173
MAIL_DELIVERY_MODE=local
# Keep the existing 201 registration contract until the verification UI is approved.
# email_verification opts into generic 202 and currently requires the local adapter.
AUTH_REGISTRATION_MODE=legacy
# Optional for development; production requires explicit HTTPS application origins.
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

