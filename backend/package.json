{
  "name": "backend",
  "version": "1.0.0",
  "description": "TechBridge API Server",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "seed": "tsx src/seed.ts",
    "seed:demo": "tsx --env-file=.env.demo src/seed.ts",
    "admin:create": "tsx src/createAdmin.ts",
    "migrate:phase2": "tsx src/migratePhase2.ts",
    "test": "npm run test:unit && npm run test:integration",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:prepare": "tsx tests/prepare-mongo.ts",
    "test:e2e:server": "tsx tests/e2e-server.ts",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json"
  },
  "keywords": [
    "techbridge",
    "api"
  ],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cors": "^2.8.5",
    "dotenv": "^16.5.0",
    "express": "^5.2.1",
    "express-validator": "^7.2.1",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.16.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/supertest": "7.2.1",
    "mongodb-memory-server-core": "11.3.0",
    "supertest": "7.3.1",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "8.2.1",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0"
  }
}
