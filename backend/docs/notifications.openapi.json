{
  "openapi": "3.1.0",
  "info": {
    "title": "TechBridge centralized in-app notifications",
    "version": "1.0.0",
    "description": "Backend-only inbox, consent and read-state contract. Active, non-revoked JWT required. New notification auth requires email-gated accounts to verify first. Provider-verification scoped sessions may read their own verification notices/preferences without gaining normal platform access. No public creation, retry, worker state, cross-user inbox, email or admin override. See notifications.md for transactional source hooks, leased worker, reminders, migrations and rollback. Verification-scoped sessions remain limited even for an approved provider and cannot update global notification preferences."
  },
  "servers": [
    {
      "url": "http://localhost:5000"
    }
  ],
  "paths": {
    "/api/notifications": {
      "get": {
        "operationId": "listOwnNotifications",
        "summary": "Read own notification history",
        "description": "Stable occurredAt descending then ID descending. Defaults page 1/limit 20; unknown filters reject. Total follows filters; unread is global own visible count. No queue/lease/dedupe/recipient authority fields are returned. Pending providers see only verification notices. Disabling future notices does not erase history.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-authorized-roles": [
          "student (own)",
          "provider (own; unverified/restricted scope verification category only)",
          "admin (own only)"
        ],
        "x-database-models": [
          "Notification",
          "User"
        ],
        "parameters": [
          {
            "name": "page",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 10000,
              "default": 1
            }
          },
          {
            "name": "limit",
            "in": "query",
            "schema": {
              "type": "integer",
              "minimum": 1,
              "maximum": 100,
              "default": 20
            }
          },
          {
            "name": "kind",
            "in": "query",
            "schema": {
              "type": "string",
              "enum": [
                "campaign",
                "message",
                "application",
                "scholarship",
                "resource",
                "verification",
                "mentorship"
              ]
            }
          },
          {
            "name": "unread",
            "in": "query",
            "schema": {
              "type": "boolean"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Success; Cache-Control: no-store",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "notifications": {
                          "type": "array",
                          "items": {
                            "$ref": "#/components/schemas/Notification"
                          }
                        },
                        "page": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 10000
                        },
                        "limit": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 100
                        },
                        "total": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 1000000
                        },
                        "pages": {
                          "type": "integer",
                          "minimum": 1,
                          "maximum": 1000000
                        },
                        "unread": {
                          "type": "integer",
                          "minimum": 0,
                          "maximum": 1000000
                        }
                      },
                      "required": [
                        "notifications",
                        "page",
                        "limit",
                        "total",
                        "pages",
                        "unread"
                      ]
                    }
                  },
                  "required": [
                    "success",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Malformed ID, unsupported filter, nonboolean state/consent or invalid page/revision",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired, revoked or invalid session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Suspended/email-gated account, changed provider scope or unavailable category",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Missing/inaccessible notification; no administrator ownership override",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Stale preference revision",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Sanitized database/transaction failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    },
