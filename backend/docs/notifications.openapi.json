                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Sanitized database/transaction failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    },
    "schemas": {
      "Error": {
        "type": "object",
        "properties": {
          "success": {
            "const": false
          },
          "message": {
            "type": "string",
            "maxLength": 1000
          }
        },
        "required": [
          "success",
          "message"
        ]
      },
      "Notification": {
        "type": "object",
        "properties": {
          "_id": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          "kind": {
            "type": "string",
            "enum": [
              "campaign",
              "message",
              "application",
              "scholarship",
              "resource",
              "verification",
              "mentorship"
            ]
          },
          "action": {
            "type": "string",
            "enum": [
              "updated",
              "invited",
              "decision",
              "appeal",
              "deadline",
              "due",
              "overdue",
              "return",
              "submitted"
            ]
          },
          "title": {
            "type": "string",
            "maxLength": 100
          },
          "body": {
            "type": "string",
            "maxLength": 500
          },
          "href": {
            "type": "string",
            "enum": [
              "/",
              "/messages",
              "/my-applications",
              "/provider/applications",
              "/my-resource-requests",
              "/provider/resource-requests",
              "/my-activity",
              "/provider-verification",
              "/community-verification",
              "/my-promotion-requests",
              "/provider/promotion-requests",
              "/impact",
              "/admin"
            ]
          },
          "sourceType": {
            "type": "string",
            "enum": [
              "campaign",
              "message",
              "application",
              "scholarship",
              "resource",
              "verification",
              "mentorship",
              "community"
            ]
          },
          "sourceId": {
            "type": "string",
            "pattern": "^[a-fA-F0-9]{24}$"
          },
          "occurredAt": {
            "type": "string",
            "format": "date-time"
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "readAt": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "_id",
          "kind",
          "action",
          "title",
          "body",
          "href",
          "occurredAt",
          "createdAt"
        ]
      },
      "Preferences": {
        "type": "object",
        "properties": {
          "inApp": {
            "type": "boolean"
          },
          "categories": {
            "type": "object",
            "properties": {
              "campaign": {
                "type": "boolean"
              },
              "message": {
                "type": "boolean"
              },
              "application": {
                "type": "boolean"
              },
              "scholarship": {
                "type": "boolean"
              },
              "resource": {
                "type": "boolean"
              },
              "verification": {
                "type": "boolean"
              },
              "mentorship": {
                "type": "boolean"
              }
            },
            "required": [
              "campaign",
              "message",
              "application",
              "scholarship",
              "resource",
              "verification",
              "mentorship"
            ]
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "inApp",
          "categories",
          "revision"
        ]
      },
      "PreferencesUpdate": {
        "type": "object",
        "properties": {
          "inApp": {
            "type": "boolean"
          },
          "categories": {
            "type": "object",
            "properties": {
              "campaign": {
                "type": "boolean"
              },
              "message": {
                "type": "boolean"
              },
              "application": {
                "type": "boolean"
              },
              "scholarship": {
                "type": "boolean"
              },
              "resource": {
                "type": "boolean"
              },
              "verification": {
                "type": "boolean"
              },
              "mentorship": {
                "type": "boolean"
              }
            },
            "required": [
              "campaign",
              "message",
              "application",
              "scholarship",
              "resource",
              "verification",
              "mentorship"
            ],
            "additionalProperties": false
          },
          "revision": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "inApp",
          "categories",
          "revision"
        ],
        "additionalProperties": false
      },
      "ReadUpdate": {
        "type": "object",
        "properties": {
          "read": {
            "type": "boolean"
          }
        },
        "required": [
          "read"
        ],
        "additionalProperties": false
      }
    }
  }
}
