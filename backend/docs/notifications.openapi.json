    "/api/notifications/preferences": {
      "get": {
        "operationId": "readOwnNotificationPreferences",
        "summary": "Read own central preferences",
        "description": "Defaults all in-app categories true at revision 0, without a database write. Existing messaging notification/communication preferences also apply at delivery. Email is not offered.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-authorized-roles": [
          "student (own)",
          "provider (own; unverified/restricted scope verification category only)",
          "admin (own only)"
        ],
        "x-database-models": [
          "NotificationPreferences",
          "User"
        ],
        "parameters": [],
        "responses": {
          "200": {
            "description": "Success; Cache-Control: no-store",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "preferences": {
                          "$ref": "#/components/schemas/Preferences"
                        },
                        "supportedChannels": {
                          "type": "array",
                          "items": {
                            "const": "in_app"
                          },
                          "minItems": 1,
                          "maxItems": 1
                        }
                      },
                      "required": [
                        "preferences",
                        "supportedChannels"
                      ]
                    }
                  },
                  "required": [
                    "success",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Malformed ID, unsupported filter, nonboolean state/consent or invalid page/revision",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired, revoked or invalid session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Suspended/email-gated account, changed provider scope or unavailable category",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Missing/inaccessible notification; no administrator ownership override",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "409": {
            "description": "Stale preference revision",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "503": {
            "description": "Sanitized database/transaction failure",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          }
        }
      },
      "put": {
        "operationId": "updateOwnNotificationPreferences",
        "summary": "Update central notification consent",
        "description": "All supported category booleans, inApp and current nonnegative whole revision required. Unknown/owner/email fields reject. User coordination lock serializes with delivery; only one concurrent edit at a revision wins. Opt-out suppresses pending/future notices, retains history and does not replay suppressed notices after later opt-in. A full session is required; provider-verification-scoped tokens may read preferences but cannot modify global consent.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-authorized-roles": [
          "student (own full session)",
          "provider (own full session)",
          "admin (own full session)"
        ],
        "x-database-models": [
          "NotificationPreferences",
          "User"
        ],
        "parameters": [],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/PreferencesUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success; Cache-Control: no-store",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "preferences": {
                          "$ref": "#/components/schemas/Preferences"
                        },
                        "supportedChannels": {
                          "type": "array",
                          "items": {
                            "const": "in_app"
                          },
                          "minItems": 1,
                          "maxItems": 1
                        }
                      },
                      "required": [
                        "preferences",
                        "supportedChannels"
                      ]
                    }
                  },
                  "required": [
                    "success",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Malformed ID, unsupported filter, nonboolean state/consent or invalid page/revision",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired, revoked or invalid session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Suspended/email-gated account, changed provider scope or unavailable category",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Missing/inaccessible notification; no administrator ownership override",
            "content": {
