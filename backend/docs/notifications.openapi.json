    "/api/notifications/{id}/read": {
      "patch": {
        "operationId": "setOwnNotificationRead",
        "summary": "Mark own notification read or unread",
        "description": "Body must contain only read:boolean. True preserves the original timestamp on repeats; false removes readAt. Another recipient/admin receives 404. Does not change occurrence time or preferences.",
        "security": [
          {
            "bearerAuth": []
          }
        ],
        "x-authorized-roles": [
          "student (own)",
          "provider (own; unverified/restricted scope verification category only)",
          "admin (own only)"
        ],
        "x-database-models": [
          "Notification",
          "User"
        ],
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^[a-fA-F0-9]{24}$"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/ReadUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Success; Cache-Control: no-store",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "const": true
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "notification": {
                          "$ref": "#/components/schemas/Notification"
                        }
                      },
                      "required": [
                        "notification"
                      ]
                    }
                  },
                  "required": [
                    "success",
                    "data"
                  ]
                }
              }
            }
          },
          "400": {
            "description": "Malformed ID, unsupported filter, nonboolean state/consent or invalid page/revision",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "401": {
            "description": "Missing, expired, revoked or invalid session",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "403": {
            "description": "Suspended/email-gated account, changed provider scope or unavailable category",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/Error"
                }
              }
            }
          },
          "404": {
            "description": "Missing/inaccessible notification; no administrator ownership override",
