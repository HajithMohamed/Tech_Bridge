          "_id": {
            "type": "string",
            "pattern": "^[a-f0-9]{24}$"
          },
          "title": {
            "type": "string",
            "maxLength": 160
          },
          "description": {
            "type": "string",
            "maxLength": 5000
          },
          "type": {
            "type": "string",
            "enum": [
              "job",
              "internship",
              "scholarship",
              "course",
              "freelance",
              "promotion",
              "workshop",
              "mentorship"
            ]
          },
          "requiredSkills": {
            "type": "array",
            "items": {
              "type": "string",
              "maxLength": 60
            },
            "maxItems": 40
          },
          "location": {
            "type": "string",
            "maxLength": 120
          },
          "workMode": {
            "type": "string",
            "enum": [
              "remote",
              "on-site",
              "hybrid"
            ]
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          },
          "applicationDeadline": {
            "type": "string",
            "format": "date-time"
          },
          "status": {
            "const": "open"
          },
          "providerId": {
            "$ref": "#/components/schemas/Provider"
          },
          "providerCredibility": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "verification": {
                "const": "provider_verified"
              }
            },
            "required": [
              "verification"
            ]
          },
          "recommendationMetadata": {
            "$ref": "#/components/schemas/RecommendationMetadata"
          },
          "preferredAcademicBackground": {
            "type": "string",
            "maxLength": 250
          },
          "recommendation": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/Recommendation"
              },
              {
                "type": "null"
              }
            ]
          },
          "classification": {
            "$ref": "#/components/schemas/Classification"
          },
          "saved": {
            "type": "boolean"
          },
          "source": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "kind": {
                "const": "techbridge"
              },
              "name": {
                "const": "TechBridge"
              },
              "detailPath": {
                "type": "string",
                "pattern": "^/opportunities/[a-f0-9]{24}$"
              }
            },
            "required": [
              "kind",
              "name",
              "detailPath"
            ]
          },
          "eligibility": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "status": {
                "const": "not_evaluated"
              },
              "checkPath": {
                "type": "string",
                "maxLength": 100
              },
              "advisory": {
                "type": "string",
                "maxLength": 150
              }
            },
            "required": [
              "status",
              "checkPath",
              "advisory"
            ]
          }
        },
        "required": [
          "_id",
          "title",
          "description",
          "type",
          "location",
          "workMode",
          "createdAt",
          "applicationDeadline",
          "status",
          "providerId",
          "providerCredibility",
          "recommendation",
          "classification",
          "saved",
          "source",
          "eligibility"
        ]
      },
      "Feed": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "opportunities": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/FeedOpportunity"
            },
            "maxItems": 50
          },
          "total": {
            "type": "integer",
            "minimum": 0
          },
          "page": {
            "type": "integer",
            "minimum": 1,
            "maximum": 100
          },
          "limit": {
            "type": "integer",
            "minimum": 1,
            "maximum": 50
          },
          "pages": {
            "type": "integer",
            "minimum": 1
          },
          "asOf": {
            "type": "string",
            "format": "date-time"
          },
          "revision": {
            "type": "integer",
            "minimum": 0
          },
          "personalized": {
            "type": "boolean"
          },
          "sort": {
            "type": "string",
            "enum": [
              "recommended",
              "newest",
              "deadline"
            ]
          },
          "method": {
            "const": "rules"
          },
          "version": {
            "const": 3
          },
          "profileCompletion": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "suggested": {
                "type": "boolean"
              },
              "message": {
                "anyOf": [
                  {
                    "type": "string",
                    "maxLength": 200
                  },
                  {
                    "type": "null"
                  }
                ]
              }
            },
            "required": [
              "suggested",
              "message"
            ]
          }
        },
        "required": [
          "opportunities",
          "total",
          "page",
          "limit",
          "pages",
          "asOf",
          "revision",
          "personalized",
          "sort",
          "method",
          "version",
          "profileCompletion"
        ]
      },
      "FeedResponse": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "success": {
            "const": true
          },
          "data": {
            "$ref": "#/components/schemas/Feed"
          }
        },
        "required": [
          "success",
          "data"
        ]
      }
    }
  }
}
